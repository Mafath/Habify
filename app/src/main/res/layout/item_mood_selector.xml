<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/spacing_small"
    android:layout_margin="@dimen/spacing_extra_small"
    android:background="@drawable/mood_selector_background"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tv_mood_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_display_large"
        android:layout_marginBottom="@dimen/spacing_extra_small"
        tools:text="😊" />

    <TextView
        android:id="@+id/tv_mood_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_label_small"
        android:textColor="@color/white"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Happy" />

</LinearLayout>