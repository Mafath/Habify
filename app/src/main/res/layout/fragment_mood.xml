<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:fillViewport="true"
        android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Section (match Habits page style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:orientation="vertical"
            android:paddingTop="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_small">

            <!-- Top Row: Hamburger + App Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="@dimen/spacing_medium"
                android:paddingStart="@dimen/spacing_large"
                android:paddingEnd="@dimen/spacing_large"
                android:paddingBottom="@dimen/spacing_small"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_menu"
                    android:layout_width="@dimen/icon_size_menu"
                    android:layout_height="@dimen/icon_size_menu"
                    android:layout_marginEnd="@dimen/spacing_medium"
                    android:contentDescription="Menu"
                    android:src="@drawable/ic_menu" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Habify"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_size_appbar_title"
                    android:textStyle="bold" />
                

            </LinearLayout>

            <!-- Title Row: Centered "Mood Journal" -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mood_title"
                android:textAlignment="center"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_headline_medium"
                android:textStyle="bold"
                android:paddingStart="@dimen/spacing_large"
                android:paddingEnd="@dimen/spacing_large" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large"
            android:focusableInTouchMode="true">

            <!-- Mood Calendar Section (moved to top) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_large"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardElevation="@dimen/elevation_large"
                app:cardBackgroundColor="@color/card_mood"
                android:outlineProvider="bounds"
                android:stateListAnimator="@null"
                app:strokeWidth="@dimen/stroke_width_none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    

                    <!-- Calendar View -->
                    <ScrollView
                        android:id="@+id/layout_mood_calendar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:visibility="visible"
                        tools:visibility="visible" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            
            <!-- Empty State -->
                    <LinearLayout
                        android:id="@+id/layout_empty_mood_history"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_large"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="@dimen/card_corner_radius_xlarge"
                            app:cardElevation="@dimen/elevation_none"
                            app:cardBackgroundColor="@color/surface_variant">

                            <ImageView
                                android:layout_width="@dimen/empty_state_icon_size"
                                android:layout_height="@dimen/empty_state_icon_size"
                                android:padding="@dimen/spacing_medium"
                                android:src="@drawable/ic_mood"
                                app:tint="@color/text_hint" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_medium"
                            android:text="No mood entries yet"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_body_medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_extra_small"
                            android:gravity="center"
                            android:text="Start tracking your mood above"
                            android:textColor="@color/text_tertiary"
                            android:textSize="@dimen/text_size_body_small" />

                    </LinearLayout>

                </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_add_mood"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/spacing_large"
        android:text="Add Mood+"
        android:textAllCaps="false"
        app:icon="@drawable/ic_add"
        app:backgroundTint="@color/primary"
        app:iconTint="@color/on_primary"
        android:textColor="@color/on_primary" />

</FrameLayout>