<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Section (match Habits page style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:orientation="vertical"
            android:paddingTop="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_small">

            <!-- Top Row: Hamburger + App Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_large"
                android:paddingEnd="@dimen/spacing_large"
                android:paddingBottom="@dimen/spacing_small"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_menu"
                    android:layout_width="@dimen/icon_size_menu"
                    android:layout_height="@dimen/icon_size_menu"
                    android:layout_marginEnd="@dimen/spacing_medium"
                    android:contentDescription="Menu"
                    android:src="@drawable/ic_menu" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Habify"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_size_appbar_title"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Title Row: Centered "Hydration Tracker" (like Habits/Mood) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hydration Tracker"
                android:textAlignment="center"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_headline_medium"
                android:textStyle="bold"
                android:paddingStart="@dimen/spacing_large"
                android:paddingEnd="@dimen/spacing_large" />

        </LinearLayout>

        

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <!-- Hydration Progress Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="0dp"
                android:layout_marginTop="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_medium"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardElevation="@dimen/elevation_large"
                app:cardBackgroundColor="@color/card_hydration"
                app:strokeWidth="@dimen/stroke_width_none"
                android:outlineProvider="bounds"
                android:stateListAnimator="@null">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large"
                    android:gravity="center">

                    <!-- Circular Progress -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progress_circular_hydration"
                            android:layout_width="@dimen/progress_indicator_size_large"
                            android:layout_height="@dimen/progress_indicator_size_large"
                            android:progress="0"
                            app:indicatorColor="@color/accent_blue"
                            app:trackColor="@color/progress_incomplete"
                            app:indicatorSize="@dimen/progress_indicator_size_large"
                            app:indicatorDirectionCircular="clockwise"
                            app:indicatorInset="@dimen/progress_indicator_inset"
                            app:showAnimationBehavior="outward" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:gravity="center">

                        <TextView
                            android:id="@+id/tv_hydration_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 of 2000"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_headline_medium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_hydration_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_title_large"
                            android:textStyle="bold" />

                        </LinearLayout>

                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_hydration_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="0 ml consumed (0%)"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body_medium"
                        tools:text="1200 ml consumed (60%)" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Current Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/card_hydration"
                android:outlineProvider="bounds"
                android:stateListAnimator="@null"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <!-- Daily Goal - Centered -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/icon_size_extra_large"
                            android:layout_height="@dimen/icon_size_extra_large"
                            android:src="@drawable/ic_star_gold"
                            android:contentDescription="Daily goal highlight"
                            android:layout_marginBottom="@dimen/spacing_small" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/daily_goal"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_body_medium" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_daily_goal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_size_display_small"
                                android:textStyle="bold"
                                tools:text="2000 ml" />

                            <ImageButton
                                android:id="@+id/btn_edit_daily_goal"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="@dimen/spacing_small"
                                android:background="@null"
                                android:contentDescription="Edit daily goal"
                                android:src="@drawable/ic_edit"
                                app:tint="@color/text_secondary" />

                        </LinearLayout>

                    </LinearLayout>


                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_large"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_water"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height_medium"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/spacing_small"
                            android:text="@string/add_water"
                            android:textColor="@color/on_primary"
                            android:textSize="@dimen/text_size_body_medium"
                            android:textAllCaps="false"
                            app:backgroundTint="@color/primary"
                            app:cornerRadius="@dimen/button_corner_radius_large"
                            app:icon="@drawable/ic_add"
                            app:iconTint="@color/on_primary"
                            app:iconGravity="textStart" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_set_reminder"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height_medium"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_small"
                            android:text="@string/set_reminder"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_size_body_medium"
                            android:textAllCaps="false"
                            app:strokeColor="@color/primary"
                            app:strokeWidth="@dimen/stroke_width_thin"
                            app:backgroundTint="@color/white"
                            app:cornerRadius="@dimen/button_corner_radius_large"
                            app:icon="@drawable/ic_alarm"
                            app:iconTint="@color/primary"
                            app:iconGravity="textStart" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Recent Intakes Title on background (always visible, not on a card) -->
            <TextView
                android:id="@+id/title_recent_intakes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="Recent Intakes"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_headline_small"
                android:textStyle="bold" />

            <!-- Background Empty State (directly under Daily Goal card) -->
            <LinearLayout
                android:id="@+id/layout_empty_hydration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_large"
                android:paddingEnd="@dimen/spacing_large"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:src="@drawable/drinking_water_bg"
                    android:scaleType="centerInside" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="Add your first water intake"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_headline_medium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:gravity="center"
                    android:text="Stay hydrated, one tap away"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body_medium" />

            </LinearLayout>

            <!-- Today's History Card (list content) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_hydration_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/card_hydration"
                android:outlineProvider="bounds"
                android:stateListAnimator="@null"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_hydration_history"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_hydration_history" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>