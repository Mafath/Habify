<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Section (match Habits page style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:orientation="vertical"
            android:paddingTop="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_small">

            <!-- Top Row: Hamburger + App Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_large"
                android:paddingEnd="@dimen/spacing_large"
                android:paddingBottom="@dimen/spacing_small"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_menu"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="@dimen/spacing_medium"
                    android:contentDescription="Menu"
                    android:src="@drawable/ic_menu" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Habify"
                    android:textColor="@color/primary"
                    android:textSize="34sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Title Row: Centered "Mood Journal" -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mood_title"
                android:textAlignment="center"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_headline_medium"
                android:textStyle="bold"
                android:paddingStart="@dimen/spacing_large"
                android:paddingEnd="@dimen/spacing_large" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large"
            android:focusableInTouchMode="true">

            <!-- Mood Calendar Section (moved to top) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_large"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/card_mood"
                android:outlineProvider="bounds"
                android:stateListAnimator="@null"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mood_calendar_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_headline_small"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="@string/mood_calendar_explanation"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body_medium" />

                    <!-- Calendar View -->
                    <ScrollView
                        android:id="@+id/layout_mood_calendar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:visibility="visible"
                        tools:visibility="visible" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Log Mood Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_large"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/card_mood"
                android:outlineProvider="bounds"
                android:stateListAnimator="@null"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/log_mood"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_headline_small"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="@string/select_mood"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body_medium" />

                    <!-- Mood Selector Grid -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_mood_selector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="10"
                        tools:listitem="@layout/item_mood_selector" />

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_large"
                        android:orientation="horizontal"
                        android:gravity="end">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_share_mood"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/button_height_small"
                            android:layout_marginEnd="@dimen/spacing_small"
                            android:text="Share Today"
                            android:textSize="@dimen/text_size_body_medium"
                            android:textAllCaps="false"
                            android:enabled="false"
                            app:strokeColor="@color/primary"
                            app:cornerRadius="@dimen/button_corner_radius" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_save_mood"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/button_height_small"
                            android:text="@string/save_mood"
                            android:textSize="@dimen/text_size_body_medium"
                            android:textAllCaps="false"
                            android:enabled="false"
                            app:backgroundTint="@color/primary"
                            app:cornerRadius="@dimen/button_corner_radius" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            
            <!-- Empty State -->
                    <LinearLayout
                        android:id="@+id/layout_empty_mood_history"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_large"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/surface_variant">

                            <ImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:padding="@dimen/spacing_medium"
                                android:src="@drawable/ic_mood"
                                app:tint="@color/text_hint" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_medium"
                            android:text="No mood entries yet"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_body_medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_extra_small"
                            android:gravity="center"
                            android:text="Start tracking your mood above"
                            android:textColor="@color/text_tertiary"
                            android:textSize="@dimen/text_size_body_small" />

                    </LinearLayout>

                </LinearLayout>

        </LinearLayout>

</androidx.core.widget.NestedScrollView>