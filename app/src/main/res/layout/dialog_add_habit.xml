<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_extra_large">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/habit_name"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="@dimen/card_corner_radius_small"
        app:boxCornerRadiusTopEnd="@dimen/card_corner_radius_small"
        app:boxCornerRadiusBottomStart="@dimen/card_corner_radius_small"
        app:boxCornerRadiusBottomEnd="@dimen/card_corner_radius_small"
        app:boxStrokeColor="@color/primary_green"
        app:hintTextColor="@color/primary_green"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_habit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:padding="@dimen/spacing_large"
            android:textSize="@dimen/text_size_title_large" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/habit_description"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="@dimen/card_corner_radius_small"
        app:boxCornerRadiusTopEnd="@dimen/card_corner_radius_small"
        app:boxCornerRadiusBottomStart="@dimen/card_corner_radius_small"
        app:boxCornerRadiusBottomEnd="@dimen/card_corner_radius_small"
        app:boxStrokeColor="@color/primary_green"
        app:hintTextColor="@color/primary_green"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_habit_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:minLines="2"
            android:padding="@dimen/spacing_large"
            android:textSize="@dimen/text_size_title_large"
            android:gravity="top" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/spacing_large">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_small"
            android:hint="@string/habit_target"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="@dimen/card_corner_radius_small"
            app:boxCornerRadiusTopEnd="@dimen/card_corner_radius_small"
            app:boxCornerRadiusBottomStart="@dimen/card_corner_radius_small"
            app:boxCornerRadiusBottomEnd="@dimen/card_corner_radius_small"
            app:boxStrokeColor="@color/primary_green"
            app:hintTextColor="@color/primary_green">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_target_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1"
                android:text="@string/default_target_value"
                android:padding="@dimen/spacing_large"
                android:textSize="@dimen/text_size_title_large" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_small"
            android:hint="@string/habit_unit"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="@dimen/card_corner_radius_small"
            app:boxCornerRadiusTopEnd="@dimen/card_corner_radius_small"
            app:boxCornerRadiusBottomStart="@dimen/card_corner_radius_small"
            app:boxCornerRadiusBottomEnd="@dimen/card_corner_radius_small"
            app:boxStrokeColor="@color/primary_green"
            app:hintTextColor="@color/primary_green">

            <AutoCompleteTextView
                android:id="@+id/spinner_unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:text="@string/unit_times"
                android:padding="@dimen/spacing_large"
                android:textSize="@dimen/text_size_title_large"
                android:focusable="false"
                android:clickable="true" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- Modern styled unit selector options -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_units"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_large"
        app:singleLine="false"
        app:chipSpacingHorizontal="@dimen/spacing_small"
        app:chipSpacingVertical="@dimen/spacing_extra_small"
        android:visibility="gone">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_times"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unit_times"
            app:chipBackgroundColor="@color/chip_background_selector"
            android:textColor="@color/text_primary" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_minutes"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unit_minutes"
            app:chipBackgroundColor="@color/chip_background_selector"
            android:textColor="@color/text_primary" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_hours"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unit_hours"
            app:chipBackgroundColor="@color/chip_background_selector"
            android:textColor="@color/text_primary" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_glasses"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unit_glasses"
            app:chipBackgroundColor="@color/chip_background_selector"
            android:textColor="@color/text_primary" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_steps"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unit_steps"
            app:chipBackgroundColor="@color/chip_background_selector"
            android:textColor="@color/text_primary" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_pages"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unit_pages"
            app:chipBackgroundColor="@color/chip_background_selector"
            android:textColor="@color/text_primary" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_km"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unit_km"
            app:chipBackgroundColor="@color/chip_background_selector"
            android:textColor="@color/text_primary" />

    </com.google.android.material.chip.ChipGroup>

</LinearLayout>